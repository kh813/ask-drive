<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="max-w-md mx-auto space-y-6 py-8">
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white flex items-center justify-center mx-auto shadow-sm">
        <.icon name="hero-shield-check" class="w-6 h-6" />
      </div>
      <h1 class="font-bold text-xl text-zinc-900 dark:text-zinc-100">
        {gettext("Enter Platform Admin")}
      </h1>
      <p class="text-xs text-zinc-500 leading-relaxed">
        {gettext("Entering as %{email}. Identity verification required. Recorded in audit log.",
          email: @current_user.email
        )}
      </p>
    </div>

    <div
      :if={@error_message}
      id="elevate-error"
      class="p-3 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300 text-xs flex items-start gap-2"
    >
      <.icon name="hero-exclamation-circle" class="w-4 h-4 shrink-0 mt-0.5" />
      <span>{@error_message}</span>
    </div>

    <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm space-y-5">
      <%= if @method == :ldap_password do %>
        <.form
          :let={f}
          for={%{}}
          as={:admin}
          action={~p"/admin/elevate"}
          id="elevate-form"
          class="space-y-4"
        >
          <.input
            field={f[:password]}
            type="password"
            label={gettext("Your Google Workspace Password (identity verification)")}
            required
            autocomplete="current-password"
          />
          <button
            type="submit"
            id="elevate-btn"
            class="w-full px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm shadow-sm transition"
          >
            {gettext("Enter Admin Screen")}
          </button>
        </.form>
      <% else %>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {gettext(
            "Please sign in again for verification (direct access allowed if signed in within %{minutes} minutes).",
            minutes: @fresh_minutes
          )}
        </p>
        <a
          id="reauth-btn"
          href={~p"/admin/reauth"}
          class="block text-center w-full px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm shadow-sm transition"
        >
          {gettext("Sign in again to enter Admin")}
        </a>
      <% end %>
    </div>

    <p class="text-center">
      <.link
        navigate={~p"/"}
        class="text-xs text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition"
      >
        {gettext("Return to Chat")}
      </.link>
    </p>
  </div>
</Layouts.app>
